          "refId": "B"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", value AS \"Battery Net Flow (kW)\" FROM sensor_readings WHERE metric='bms_power_kw' AND $__timeFilter(ts) ORDER BY ts ASC;",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kW",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
