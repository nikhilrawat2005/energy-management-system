      "description": "Real-time natural language reasoning produced by Ollama LLM analyzing the multi-agent consensus",
      "gridPos": { "h": 8, "w": 15, "x": 0, "y": 8 },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT to_char(ts, 'HH24:MI:SS') AS \"Time (UTC)\", action_name AS \"Coordinator Action\", reasoning AS \"Ollama Strategic Analysis & 4-Hour Outlook\" FROM ai_reasoning_log ORDER BY ts DESC LIMIT 1;",
        "refId": "A"
      }],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time (UTC)" }, "properties": [{ "id": "custom.width", "value": 110 }] },
          { "matcher": { "id": "byName", "options": "Coordinator Action" }, "properties": [{ "id": "custom.width", "value": 240 }] },
          { "matcher": { "id": "byName", "options": "Ollama Strategic Analysis & 4-Hour Outlook" }, "properties": [{ "id": "custom.displayMode", "value": "auto" }] }
        ]
      },
      "options": {
        "showHeader": true
      },
      "datasource": "timescale"
    },
    {
      "id": 11,
      "title": "\ud83e\udd16 AI Engine Model",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 8 },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COALESCE((SELECT UPPER(source) || ' (' || model || ')' FROM ai_reasoning_log ORDER BY ts DESC LIMIT 1), 'STANDBY') AS \"Engine\";",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "background"
      },
      "datasource": "timescale"
    },
    {
      "id": 12,
      "title": "\u23f1\ufe0f AI Latency (s)",
      "type": "gauge",
      "description": "LLM response generation latency in seconds",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COALESCE((SELECT ROUND((latency_ms / 1000.0)::numeric, 1) FROM ai_reasoning_log ORDER BY ts DESC LIMIT 1), 0) AS \"Latency (s)\";",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 120,
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 45 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "datasource": "timescale",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
