      "id": 6,
      "title": "CT Load Current (A)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 7 },
      "targets": [{ "format": "table", "rawSql": "SELECT value AS \"CT Amperes\" FROM sensor_readings WHERE metric='ct_current_a' ORDER BY ts DESC LIMIT 1;", "refId": "A" }],
